# 后端生产环境变量样例(部署到 Railway / Render / Fly.io 时使用)
# 复制本文件为 backend/.env(本地)或在部署平台设置这些变量

# === 服务端口(Railway 会自动注入 PORT,可不设) ===
PORT=3000

# === Supabase(https://supabase.com → 项目 → Settings → API) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# === Kimi LLM(https://platform.moonshot.cn) ===
KIMI_API_KEY=sk-xxx
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5

# === SiliconFlow(可选,DeepSeek / MiniMax 用) ===
SILICONFLOW_API_KEY=sk-xxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3.2
MINIMAX_MODEL=MiniMaxAI/MiniMax-M2.5

# === 默认 LLM 模型 ===
DEFAULT_LLM=kimi

# === CORS 白名单 ===
# 本地开发:http://localhost:5173
# 生产:你的 Vercel URL(如 https://your-app.vercel.app),多个用逗号分隔
ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
